# ----- App -----
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ----- Auth -----
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# ----- Postgres -----
POSTGRES_USER=homeorg
POSTGRES_PASSWORD=homeorg
POSTGRES_DB=homeorg
DATABASE_URL=postgresql+asyncpg://homeorg:homeorg@postgres:5432/homeorg
DATABASE_URL_SYNC=postgresql+psycopg://homeorg:homeorg@postgres:5432/homeorg

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- MinIO / S3 -----
# Inside Docker, the API reaches MinIO at `minio:9000`.
MINIO_ROOT_USER=homeorg
MINIO_ROOT_PASSWORD=homeorg-minio
MINIO_ENDPOINT=minio:9000
# Browsers reach MinIO at `localhost:9000`. Set this so presigned URLs the
# API issues point at a host the browser can resolve. Leave blank to fall
# back to MINIO_ENDPOINT (single-host / single-network deployments only).
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET_ITEMS=home-organizer-items
MINIO_BUCKET_UPLOADS=home-organizer-uploads
MINIO_USE_SSL=false

# ----- Storage backend -----
# `minio` uses the S3-compatible server above. `local` writes to
# STORAGE_LOCAL_DIR on this machine and serves the bytes back through
# `GET /api/v1/files/{key}`; it exists so the app runs with no object store.
# Under `local`, `POST /uploads/presign` answers 409 — the browser uploads via
# `POST /assets/upload` instead.
STORAGE_BACKEND=minio
STORAGE_LOCAL_DIR=./var/storage
# Signing key for local-storage read URLs. Leave blank to fall back to
# JWT_SECRET. Set it explicitly when several services share one JWT_SECRET but
# should not be able to mint storage URLs for each other.
STORAGE_LOCAL_SECRET=
# Absolute origin prepended to locally-issued URLs. Leave blank to emit
# root-relative URLs, which the browser resolves against the web origin and the
# Next.js rewrite proxies back to this API. Set it only when the API is reached
# on a different origin than the one serving the page.
API_PUBLIC_BASE_URL=

# ----- AI Provider -----
AI_PROVIDER=openai_compatible
AI_API_KEY=sk-xxxxx-replace-me
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_VISION=gpt-4o
AI_MODEL_RECOMMEND=gpt-4o-mini
AI_TIMEOUT_S=30

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
