# Application
APP_ENV=development
APP_NAME=home-organizer-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (async — used at runtime)
DATABASE_URL=postgresql+asyncpg://homeorg:homeorg@localhost:5432/homeorg
# Database (sync — used by Alembic)
DATABASE_URL_SYNC=postgresql+psycopg://homeorg:homeorg@localhost:5432/homeorg
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# JWT — REPLACE in production
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# AI Provider
AI_PROVIDER=openai_compatible
AI_API_KEY=sk-xxxxx-replace-me
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_VISION=gpt-4o
AI_MODEL_RECOMMEND=gpt-4o-mini
AI_TIMEOUT_S=30

# CORS — comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=homeorg
MINIO_ROOT_PASSWORD=homeorg-minio
MINIO_BUCKET_ITEMS=home-organizer-items
MINIO_BUCKET_UPLOADS=home-organizer-uploads
MINIO_USE_SSL=false
