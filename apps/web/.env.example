# Backend API base URL (server-side). All API calls go through Next.js rewrites.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Default home and user for stub auth (used by the demo).
# In production these come from the JWT-authenticated session.
NEXT_PUBLIC_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_DEFAULT_HOME_ID=00000000-0000-0000-0000-000000000002
