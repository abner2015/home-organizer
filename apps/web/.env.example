# Backend API base URL (server-side). Browser calls go through the Next.js
# rewrite in `next.config.mjs`, so neither this URL nor the API key ever
# reaches the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# There is no stub auth any more. Sign in at /login: the session (access token
# + which home to act in) lives in cookies set by `src/lib/session.ts`, and the
# home is discovered from `GET /api/v1/homes` rather than configured here.
# Seeded demo account: demo@example.com / demo1234
